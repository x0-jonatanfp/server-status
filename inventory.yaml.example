# Inventario de lo que se monitoriza. Copia este fichero a inventory.yaml y
# ajustalo a tu maquina:
#
#   cp inventory.yaml.example inventory.yaml
#
# El repo no incluye canales, hosts ni sensores reales: todo sale de aqui y del
# .env. Cualquier clave desconocida o mal puesta aborta el arranque diciendo
# cual es.

# Webs publicas que se comprueban por HTTP.
websites:
  - url: https://example.com
    label: example

# Unidades systemd, agrupadas para que el mensaje no sea una lista plana.
services:
  - group: Infra
    units: [nginx, fail2ban, postgresql@16-main, redis-server]
  - group: Apps
    units: [my-app]
  - group: Bots
    units: [server-status]

# Sensores de temperatura. `source: hwmon` lee /sys/class/hwmon y no necesita
# privilegios; `source: smartctl` consulta un disco SATA y puede requerir una
# regla NOPASSWD para /usr/sbin/smartctl.
# Las lecturas fuera del rango 1-120 C se descartan y el sensor sale N/A.
# Aqui no hay una seccion de temperaturas en el mensaje: cada lectura viaja en
# la fila de recursos que la enlaza con `temperature`.
temperatures:
  - source: hwmon
    chip: k10temp
    label: Tctl
    name: CPU
    warn: 75
    crit: 90
  - source: hwmon
    chip: amdgpu
    label: edge
    name: GPU
    warn: 80
    crit: 91
  - source: hwmon
    chip: nvme
    label: Composite
    name: NVMe
    warn: 70
    crit: 79
  - source: smartctl
    device: /dev/sda
    name: SSD
    warn: 60
    crit: 70

# Filas de recursos del mensaje, en este orden: CPU, GPU, RAM y los volumenes.
# La etiqueta (se pinta en mayusculas) y el emoji salen de aqui, y `temperature`
# enlaza con el `name` de un sensor de arriba: si no existe, el arranque aborta.
resources:
  cpu:
    label: CPU
    icon: "🧠"
    temperature: CPU
  gpu:
    label: GPU
    icon: "🎮"
    temperature: GPU
    # Fichero del kernel con el uso de la GPU (`*` vale por la tarjeta que sea).
    # Si no existe o no se puede leer, la fila sale sin barra y sin porcentaje.
    busy_percent_path: /sys/class/drm/card*/device/gpu_busy_percent
  memory:
    label: RAM
    icon: "💾"
  # Un volumen por fila: el punto de montaje tiene que coincidir EXACTAMENTE con
  # el que reporta el sistema. Un mount que no exista deja la fila sin datos, no
  # se sustituye por el de su directorio padre.
  disks:
    - label: Disco
      icon: "💽"
      mount: /
      temperature: NVMe
    - label: Datos
      icon: "📀"
      mount: /mnt/datos

# Que se muestra en el mensaje y con que colores.
display:
  # `false` = todos los servicios en un solo flujo, que Discord parte en lineas.
  # `true` = una linea por grupo (Infra/Apps/Bots).
  show_groups: false
  show_fail2ban_breakdown: true
  show_ping: true
  # Cuadrados de las barras de recursos (1-10).
  progress_bar_blocks: 10
  colors:
    ok: "#00FF41"
    warning: "#FFAA00"
    critical: "#FF0040"

# Umbrales de alerta. El cooldown evita repetir la misma alerta en cada ciclo.
alerts:
  cooldown_minutes: 30
  thresholds:
    cpu_percent: { warn: 70, crit: 90 }
    memory_percent: { warn: 70, crit: 90 }
    disk_percent: { warn: 80, crit: 95 }
    ping_ms: { warn: 100, crit: 500 }
