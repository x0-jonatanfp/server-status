# Configuracion del bot. Copia este fichero a .env y rellena los valores.
#
#   cp .env.example .env && chmod 600 .env
#
# El .env NO se versiona: lleva el token del bot. El inventario (webs, servicios,
# sensores y umbrales) va aparte, en inventory.yaml.

# --- Discord ---------------------------------------------------------------
# Token del bot. Se saca del portal de desarrolladores de Discord, en la
# pestana Bot de la aplicacion (ver README). Obligatorio.
DISCORD_TOKEN=

# Nombre visible del bot en la lista de miembros.
BOT_DISPLAY_NAME=server-status

# Presencia del bot (el texto junto al avatar). Tipos: Playing, Streaming,
# Listening, Watching, Custom, Competing. Con Custom, BOT_ACTIVITY_STATE se
# muestra como estado personalizado.
BOT_ACTIVITY_TYPE=Custom
BOT_ACTIVITY_NAME=example.com
BOT_ACTIVITY_STATE=🔗 example.com
# Solo se usa con BOT_ACTIVITY_TYPE=Streaming, y solo admite Twitch o YouTube.
BOT_ACTIVITY_URL=

# Ids del servidor y de los canales. Un id de Discord es un numero de 17-20
# digitos. STATUS_CHANNEL_ID es obligatorio; los demas son opcionales.
GUILD_ID=
STATUS_CHANNEL_ID=
ALERT_CHANNEL_ID=

# Roles con permiso para los comandos de consulta y desbaneo. Admite el formato
# [Rol A],[Rol B] o una lista separada por comas. Vacio = solo administradores.
REQUIRED_ROLES=

# --- Ciclo y recoleccion ---------------------------------------------------
# Segundos entre actualizaciones del mensaje de estado (10-86400).
UPDATE_INTERVAL=300
# Timeout de las comprobaciones web, en milisegundos.
HTTP_TIMEOUT_MS=8000
# Punto de montaje que se mide para el disco.
DISK_MOUNT=/
# Ruta del inventario y del estado persistente (canales y mensajes).
INVENTORY_PATH=inventory.yaml
STATE_PATH=data/state.json

# --- Logs ------------------------------------------------------------------
LOG_FILE=logs/bot.log
# Nivel de winston: error, warn, info, http, verbose, debug o silly.
LOG_LEVEL=info

# --- Binarios del sistema --------------------------------------------------
# Rutas absolutas de los binarios que se invocan sin shell.
SUDO_PATH=/usr/bin/sudo
FAIL2BAN_CLIENT=/usr/bin/fail2ban-client
